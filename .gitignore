# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude-code brainstorming companion (local mockups, not project source)
.superpowers/

# git worktrees for isolated subagent-driven implementation
.worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor (wrapper nativo pra Play Store/App Store) — projeto android/ e
# ios/ ficam versionados (não tem CI de mobile, precisa persistir entre
# sessões/máquinas), só os artefatos de build e caminhos locais da máquina
# ficam de fora.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/google-services.json
android/captures/
android/.externalNativeBuild/
android/.cxx/
ios/App/Pods/
ios/App/App/GoogleService-Info.plist
ios/App/build/
ios/App/output/
ios/DerivedData/
*.xcuserstate
xcuserdata/
