# NEXT_PUBLIC_*: inlinadas no bundle do cliente em build-time. Em
# deploy via Dockerfile (self-host), precisam ser passadas como build
# args, não só como env var de runtime.
NEXT_PUBLIC_SUPABASE_URL=https://dwswpwxnzjgoohucngbb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: lida em runtime, nunca chega no bundle do cliente. Só
# precisa ser env var de runtime (não build arg).
GOOGLE_MAPS_API_KEY=
