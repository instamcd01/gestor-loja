# NEXT_PUBLIC_*: inlinadas no bundle do cliente em build-time. Em
# deploy via Dockerfile (self-host), precisam ser passadas como build
# args, não só como env var de runtime.
NEXT_PUBLIC_SUPABASE_URL=https://dwswpwxnzjgoohucngbb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: lidas em runtime, nunca chegam no bundle do cliente. Só
# precisam ser env var de runtime (não build arg).
GOOGLE_MAPS_API_KEY=
# Domínio de produção do site, sem barra no fim — usado pra montar o
# redirect_uri do OAuth do Mercado Pago (tem que bater exatamente com o
# redirect_uri configurado na aplicação do painel do Mercado Pago, e com
# o kSiteBaseUrl hardcoded em mercado_pago_conectar_screen.dart no app).
# Sem prefixo NEXT_PUBLIC_ de propósito: só é lida em código server-only
# (mercadopago.ts), nunca precisa ir pro bundle do cliente.
SITE_URL=

# Service role do Supabase — ignora RLS. Só usada em rotas sem sessão de
# usuário (webhook e callback OAuth do Mercado Pago). NUNCA prefixar com
# NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Credenciais da aplicação Mercado Pago DA PLATAFORMA (uma só, criada com
# acesso de Marketplace/split payments no painel de desenvolvedores) —
# não são credenciais por loja, essas ficam em empresa_mercadopago.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
# Configurado como segredo do webhook na aplicação MP — valida a
# assinatura das notificações antes de confiar em qualquer uma.
MERCADO_PAGO_WEBHOOK_SECRET=
