                "qtd_8": "${form.qtd_8}", "produto_id_8": "${data.produto_id_8}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "RESUMO",
      "title": "Resumo do pedido",
      "terminal": false,
      "data": {
        "resumo_texto": { "type": "string", "__example__": "" },
        "total": { "type": "string", "__example__": "" },
        "erro": { "type": "string", "__example__": "" },
        "itens_json": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.erro}", "visible": "`${data.erro} != ''`" },
          { "type": "TextBody", "text": "${data.resumo_texto}" },
          { "type": "TextSubheading", "text": "${data.total}" },
          {
            "type": "Footer",
            "label": "Confirmar pedido",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "acao": "confirmar", "itens_json": "${data.itens_json}" }
            }
          }
        ]
      }
    },
    {
      "id": "CONFIRMADO",
      "title": "Pedido confirmado",
      "terminal": true,
      "success": true,
      "data": {
        "mensagem": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.mensagem}" },
          {
            "type": "Footer",
            "label": "Fechar",
            "on-click-action": { "name": "complete", "payload": {} }
          }
        ]
      }
    }
  ]
}
